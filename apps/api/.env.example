NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alansari_travel?schema=public
APP_TIMEZONE=Asia/Riyadh
LOG_LEVEL=debug
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
GENERAL_RATE_LIMIT_WINDOW_MINUTES=15
GENERAL_RATE_LIMIT_MAX_REQUESTS=300
SHUTDOWN_GRACE_SECONDS=10
ERROR_MONITORING_DSN=
REPORT_ARABIC_FONT_PATH=
